START

    // TODO 1: Identify the information the movement process needs
    // We need the player's current room and the layout of the game map
    // We also need the directional command the player wants to take
    
    DECLARE current_room AS STRING
    DECLARE command AS STRING
    DECLARE next_room AS STRING


    // TODO 2: Prompt for and receive the player's movement command
    OUTPUT "You are in the " + current_room
    OUTPUT "Enter a direction to move (e.g., North, South, East, West): "
    INPUT command


    // TODO 3: Validate whether the requested movement is possible from the current room
    // Check if the chosen direction connects to another room on the map
    IF map[current_room][command] EXISTS THEN
    
        // TODO 4: Describe what happens when the movement command is valid
        // Update the room and display the success to the player
        next_room = map[current_room][command]
        current_room = next_room
        OUTPUT "You successfully moved to the " + current_room + "."
        
    ELSE
    
        // TODO 5: Describe what happens when the movement command is invalid
        // Keep the player in the same room and output an error message
        OUTPUT "You cannot go that way! There is no exit in that direction."
        OUTPUT "You remain in the " + current_room + "."
        
    ENDIF


    // TODO 6: Show how movement fits into repeated gameplay
    // This process typically runs inside a main game loop until an ending condition is met
    // (e.g., reaching the exit room or encountering a game-over condition)
    
    IF current_room == "Exit Room" THEN
        OUTPUT "Congratulations! You have escaped and won the game!"
        SET game_running = FALSE
    ENDIF

END
